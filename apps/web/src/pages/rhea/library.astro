---
import '../../styles/fonts.css';
import '../../rhea/tokens.css';
import '../../rhea/styles.css';
import '../../rhea/tones.css';
import '../../rhea/autoral.css';
import '../../rhea/lamps.css';
import TelegramLibrary from '../../rhea/library/TelegramLibrary.astro';
import RheaFace from '../../rhea/RheaFace.astro';

const links = [['/rhea/arquivos', 'Drive'], ['/rhea/mega', 'MEGA'], ['#telegram', 'Telegram'], ['#forum-inventory', 'Tópicos'], ['#anime-enrichment', 'Organizar']];
---
<!doctype html>
<html lang="pt-BR" data-mode="autoral" data-tone="floresta" data-theme="dark" data-glass="off">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <meta name="referrer" content="no-referrer">
  <title>Telegram · RHEA</title>
  <script is:inline src="/rhea-ui/settings.js"></script>
  <script>
    import '../../rhea/library/telegram-panel.mjs';
  </script>
</head>
<body class="library">
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <div class="shell">
    <aside class="sidebar prism-surface">
      <a class="brand" href="/rhea" aria-label="Voltar à RHEA"><RheaFace rows={7} /><span><strong>RHEA</strong></span></a>
      <nav class="side-nav" aria-label="Navegação da RHEA">
        {links.map(([href, label]) => <a href={href} aria-current={href === "#telegram" ? "page" : undefined}>{label}</a>)}
      </nav>
    </aside>
    <div class="workspace">
      <header class="mobile-head prism-surface">
        <div class="mobile-masthead"><a class="brand" href="/rhea" aria-label="Voltar à RHEA"><RheaFace rows={7} /><span><strong>RHEA</strong></span></a></div>
        <nav class="section-nav" aria-label="Navegação da RHEA">{links.map(([href, label]) => <a href={href} aria-current={href === "#telegram" ? "page" : undefined}>{label}</a>)}</nav>
      </header>
      <main id="conteudo" class="library-main" tabindex="-1">
        <header class="library-hero" id="telegram">
          <p class="overline">Canal privado</p>
          <h1>Telegram</h1>
          <p>Encontre uma série e confira em que ordem os episódios ficariam no canal.</p>
        </header>
        <section class="library-inventory prism-surface" aria-labelledby="connection-title">
          <div>
            <h2 id="connection-title">Conexão de teste</h2>
            <p id="telegram-status" role="status">Verificando se o ambiente de teste está configurado.</p>
          </div>
          <button class="editorial-action" type="button" id="telegram-check" hidden>Verificar conexão</button>
        </section>
        <TelegramLibrary />
      </main>
    </div>
  </div>
</body>
</html>
