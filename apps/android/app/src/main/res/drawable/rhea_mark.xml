<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0e0d0a" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#e2c35c" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <rotate android:fromDegrees="45" android:toDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="#e2c35c" />
            </shape>
        </rotate>
    </item>
</layer-list>
