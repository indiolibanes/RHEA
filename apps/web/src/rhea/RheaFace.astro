---
// Rhea's face, formed by lamps. The static frame ships in the HTML; lamps.mjs
// takes over on a canvas to blink, look around, smile and ripple when touched.
// Size comes from the surrounding CSS (no inline styles, for the CSP).
import { staticSvg } from './lamps.mjs';

interface Props {
  rows?: number;
  label?: string;
}

const { rows = 11, label } = Astro.props;
const uid = 'rhea-' + Math.random().toString(36).slice(2, 8);
---

<span
  class="rhea-lamps"
  data-rhea-lamps
  data-rows={rows}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg viewBox="0 0 96 96" focusable="false" aria-hidden="true" set:html={staticSvg({ rows, idPrefix: uid })} />
</span>
