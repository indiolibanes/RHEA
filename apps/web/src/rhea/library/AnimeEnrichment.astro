<details class="library-section" id="anime-enrichment">
  <summary><strong>Organizar com metadados</strong></summary>
  <p id="enrich-source" tabindex="-1" role="status"></p>
  <form class="library-form" id="enrich-form" method="post" hidden>
    <label>Obra e temporada detectadas <select id="enrich-group" required></select></label>
    <label>Título para consulta <input id="enrich-title" type="search" minlength="2" maxlength="120" required></label>
    <div class="library-actions">
      <button type="submit" class="editorial-action rhea-primary" id="enrich-search">Buscar no AniList</button>
      <button type="button" class="editorial-action" id="enrich-use-title">Usar título sem metadados</button>
    </div>
  </form>
  <p id="enrich-status" role="status"></p>
  <a id="enrich-provider-search" href="https://anilist.co/search/anime" target="_blank" rel="noopener noreferrer" hidden>Pesquisar no site do AniList</a>
  <div id="enrich-candidates" class="library-catalog"></div>
  <div id="enrich-result" hidden>
    <h3 id="enrich-review-title" tabindex="-1">Conferir organização</h3>
    <p id="enrich-match"></p>
    <p id="enrich-destination"></p>
    <p id="enrich-volume"></p>
    <p id="enrich-review"></p>
    <blockquote id="enrich-caption"></blockquote>
    <div class="library-actions" id="enrich-links"></div>
    <div class="library-actions">
      <button class="editorial-action rhea-primary" id="enrich-check-destinations" type="button" hidden>Conferir destinos</button>
    </div>
    <p id="enrich-destination-status" role="status"></p>
    <ul id="enrich-destinations" hidden></ul>
    <div id="enrich-order" class="library-orders">
      <details><summary>Ordem na origem</summary><ol id="enrich-original" class="library-order"></ol></details>
      <details open><summary>Ordem por episódio</summary><ol id="enrich-sorted" class="library-order"></ol></details>
    </div>
  </div>
</details>
<script>
  import './anime-enrichment-panel.mjs';
</script>
<style>
  #enrich-form .library-actions { grid-column: 1 / -1; }
</style>
